#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

usage() {
  cat <<'EOF'
Usage: script/seed [options]

Seed demo data in this order:
  1) create/update users from data/demo_users.json
  2) extract data/images.zip
  3) create posts from data/demo_posts_text.json with extracted images
  4) create comments mixing three patterns:
       - heavy commenters (top ~10% of users write ~50% of comments)
       - flame posts     (~1% of posts attract ~30% of comments)
       - even spread     (remaining ~20% scattered across all posts)
     Comments target DB-wide users (del_flg=0) and posts.

Options:
  --users-json PATH     Users JSON file (default: data/demo_users.json)
  --posts-json PATH     Post bodies JSON file (default: data/demo_posts_text.json)
  --images-zip PATH     Images zip file (default: data/images.zip)
  --extract-dir PATH    Extraction directory (default: data)
  --post-count NUM      Number of posts to create (default: 100)
  --user-count NUM      Number of users to create (default: 100 = len(users JSON))
                        Cycles through base users with a _<cycle> suffix when > 100.
  --comment-count NUM   Number of comments to create (default: post_count * 3).
                        Pass 0 to skip comment seeding entirely.
  --heavy-user-rate R   Fraction of DB users acting as heavy commenters (0, 1].
                        Default: 0.10 (= top 10% of users).
  --flame-post-rate R   Fraction of DB posts acting as flame posts (0, 1].
                        Default: 0.01 (= 1% of posts).
                        Lower this to concentrate flame comments on fewer posts.
  -h, --help            Show this help

Environment:
  ISUCONP_DATABASE_URL  PostgreSQL URL (default: postgresql://isuconp:isuconp@127.0.0.1:5432/isuconp)
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

log() {
  echo "[seed] $*"
}

load_env_file() {
  local env_file="${ROOT_DIR}/.env"
  if [[ -f "${env_file}" ]]; then
    log "Loading environment from ${env_file}"
    set -a
    # shellcheck disable=SC1090
    source "${env_file}"
    set +a
  fi
}

load_env_file

UV_BIN=""
if command -v uv >/dev/null 2>&1; then
  UV_BIN="uv"
elif [[ -x .venv/bin/uv ]]; then
  UV_BIN=".venv/bin/uv"
else
  echo "Error: 'uv' is required but not installed (or .venv/bin/uv missing)." >&2
  exit 1
fi

exec "${UV_BIN}" run python script/seed_impl.py "$@"
