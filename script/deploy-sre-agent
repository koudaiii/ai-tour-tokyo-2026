#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NOW_YYYYMMDDHHMM="$(date +%Y%m%d%H%M)"
TEMPLATE_FILE="${ROOT_DIR}/infra/sre-agent.bicep"
ENV_FILE="${ROOT_DIR}/.env"
TAGS_JSON='{"CostControl":"ignore","SecurityControl":"ignore","GitHub Repository":"koudaiii/ai-tour-tokyo-2026"}'
WORKLOAD_CODE="pisu"
DEPLOYMENT_ENVIRONMENT="sandbox"

usage() {
  cat <<'EOF'
Usage: script/deploy-sre-agent [options]

Deploy Azure SRE Agent (Microsoft.App/agents) for the private-isu application.

The SRE Agent itself is provisioned in an SRE-supported region (eastus2,
swedencentral, or australiaeast) into a dedicated resource group. RBAC roles
are granted to the agent's managed identity on the existing application
resource group (typically deployed via script/deploy-infra in japaneast).

Options:
  --tag KEY=VALUE             Azure resource tag used to locate the target
                              application resources and resource group. The
                              tag is matched against resources in the
                              subscription via Azure Resource Graph / az
                              resource list. Default: 'GitHub Repository=koudaiii/ai-tour-tokyo-2026'
                              (matches resources deployed by script/deploy-infra).
  --main-resource-group NAME  Explicit application resource group (skips
                              tag-based lookup).
  --location LOCATION         SRE Agent region: eastus2|swedencentral|australiaeast
                              (default: australiaeast)
  --region-code CODE          Region code used in names (default: derived from location)
  --deployment-name NAME      Deployment name (default: sre-agent-YYYYMMDDHHmm)
  --date-suffix VALUE         nowYyyymmddHhmm parameter (default: YYYYMMDDHHmm)
  --agent-name NAME           Override the generated SRE Agent name
  --app-insights-name NAME    Override Application Insights name lookup
  --container-app NAME        Override Container App name lookup (added to knowledge graph)
  --postgres-server NAME      Override PostgreSQL Flexible Server name lookup
  --access-level LEVEL        High|Low (default: High)
  --action-mode MODE          Review|Automatic (default: Review)
  --dry-run                   Run what-if instead of create
  -h, --help                  Show this help

Examples:
  # Default: discover via 'GitHub Repository=koudaiii/ai-tour-tokyo-2026' tag
  script/deploy-sre-agent

  # Filter by a different tag
  script/deploy-sre-agent --tag environment=sandbox

  # Explicit main RG override
  script/deploy-sre-agent \
    --main-resource-group rg-pisu-sandbox-jpe-2605120930 \
    --dry-run
EOF
}

require_cmd() {
  local cmd="$1"
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "Error: '${cmd}' is required but not installed." >&2
    exit 1
  fi
}

log() {
  echo "[deploy-sre-agent] $*"
}

load_env_file() {
  if [[ -f "${ENV_FILE}" ]]; then
    log "Loading environment from ${ENV_FILE}"
    set -a
    # shellcheck disable=SC1090
    source "${ENV_FILE}"
    set +a
  fi
}

run_az() {
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    local first=1
    local arg
    for arg in az "$@"; do
      if [[ "${first}" -eq 1 ]]; then
        printf '%q' "${arg}"
        first=0
      else
        printf ' %q' "${arg}"
      fi
    done
    printf '\n'
    return 0
  fi
  az "$@"
}

ensure_azure_login() {
  if ! az account show --output none >/dev/null 2>&1; then
    echo "Error: Azure login required. Run 'az login' first." >&2
    exit 1
  fi
  local account
  account="$(az account show --query '{user:user.name,subscription:name}' -o tsv 2>/dev/null | tr '\t' ' ')"
  log "Azure login confirmed: ${account}"
}

ensure_sre_provider_registered() {
  local state
  state="$(az provider show --namespace Microsoft.App --query registrationState -o tsv 2>/dev/null || echo NotRegistered)"
  if [[ "${state}" != "Registered" ]]; then
    log "Registering Microsoft.App resource provider (current state: ${state})"
    run_az provider register --namespace Microsoft.App --wait --only-show-errors
  fi

  local has_agents
  has_agents="$(az provider show --namespace Microsoft.App --query "resourceTypes[?resourceType=='agents'] | length(@)" -o tsv 2>/dev/null || echo 0)"
  if [[ "${has_agents}" == "0" ]]; then
    echo "Error: Microsoft.App/agents resource type is not available in this subscription." >&2
    echo "  SRE Agent may not be enabled yet. Contact your Azure administrator." >&2
    exit 1
  fi
}

resolve_region_code_from_location() {
  case "${LOCATION}" in
    eastus2) REGION_CODE="eus2" ;;
    swedencentral) REGION_CODE="sec" ;;
    australiaeast) REGION_CODE="aue" ;;
    *) REGION_CODE="$(echo "${LOCATION}" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]' | cut -c1-4)" ;;
  esac
}

validate_tag_format() {
  if [[ ! "${TAG_FILTER}" == *=* ]]; then
    echo "Error: --tag must be in KEY=VALUE format (got: ${TAG_FILTER})" >&2
    exit 1
  fi
}

resolve_main_resource_group_from_tag() {
  log "Searching for resources tagged '${TAG_FILTER}'..."
  local rg_list
  rg_list="$(az resource list --tag "${TAG_FILTER}" --query '[].resourceGroup' -o tsv 2>/dev/null | sort -u || true)"
  if [[ -z "${rg_list}" ]]; then
    echo "Error: no resources found with tag '${TAG_FILTER}'. Verify the tag or pass --main-resource-group explicitly." >&2
    exit 1
  fi

  local rg_count
  rg_count="$(echo "${rg_list}" | grep -c '^' || echo 0)"
  if [[ "${rg_count}" -gt 1 ]]; then
    echo "Error: tag '${TAG_FILTER}' matches resources in multiple resource groups:" >&2
    echo "${rg_list}" | sed 's/^/  - /' >&2
    echo "Pass --main-resource-group to disambiguate." >&2
    exit 1
  fi
  MAIN_RESOURCE_GROUP="${rg_list}"
  log "Resolved main resource group from tag: ${MAIN_RESOURCE_GROUP}"
}

infer_main_resource_group() {
  if [[ -n "${MAIN_RESOURCE_GROUP}" ]]; then
    log "Using explicit main resource group: ${MAIN_RESOURCE_GROUP}"
    return 0
  fi
  validate_tag_format
  resolve_main_resource_group_from_tag
}

resolve_app_insights() {
  if [[ -z "${APP_INSIGHTS_NAME}" ]]; then
    APP_INSIGHTS_NAME="$(az resource list --resource-group "${MAIN_RESOURCE_GROUP}" --resource-type Microsoft.Insights/components --query '[0].name' -o tsv 2>/dev/null || true)"
  fi
  if [[ -z "${APP_INSIGHTS_NAME}" ]]; then
    echo "Error: no Application Insights instance found in ${MAIN_RESOURCE_GROUP}. Pass --app-insights-name." >&2
    exit 1
  fi
  APP_INSIGHTS_APP_ID="$(az monitor app-insights component show --app "${APP_INSIGHTS_NAME}" --resource-group "${MAIN_RESOURCE_GROUP}" --query appId -o tsv 2>/dev/null || true)"
  APP_INSIGHTS_CONNECTION_STRING="$(az monitor app-insights component show --app "${APP_INSIGHTS_NAME}" --resource-group "${MAIN_RESOURCE_GROUP}" --query connectionString -o tsv 2>/dev/null || true)"
  APP_INSIGHTS_RESOURCE_ID="$(az monitor app-insights component show --app "${APP_INSIGHTS_NAME}" --resource-group "${MAIN_RESOURCE_GROUP}" --query id -o tsv 2>/dev/null || true)"

  if [[ -z "${APP_INSIGHTS_APP_ID}" || -z "${APP_INSIGHTS_CONNECTION_STRING}" ]]; then
    echo "Error: failed to read Application Insights '${APP_INSIGHTS_NAME}' in ${MAIN_RESOURCE_GROUP}." >&2
    echo "  Ensure 'azure-cli-monitor-app-insights' extension is installed: az extension add --name application-insights" >&2
    exit 1
  fi
  log "Application Insights: ${APP_INSIGHTS_NAME}"
}

resolve_managed_resource_ids() {
  MANAGED_RESOURCE_IDS=()

  # Prefer explicit overrides.
  local container_app_id=""
  if [[ -n "${CONTAINER_APP_NAME_OVERRIDE}" ]]; then
    container_app_id="$(az containerapp show --name "${CONTAINER_APP_NAME_OVERRIDE}" --resource-group "${MAIN_RESOURCE_GROUP}" --query id -o tsv 2>/dev/null || true)"
    if [[ -n "${container_app_id}" ]]; then
      MANAGED_RESOURCE_IDS+=("${container_app_id}")
      log "Knowledge graph: Container App = ${container_app_id}"
    fi
  fi

  local postgres_id=""
  if [[ -n "${POSTGRES_SERVER_OVERRIDE}" ]]; then
    postgres_id="$(az postgres flexible-server show --name "${POSTGRES_SERVER_OVERRIDE}" --resource-group "${MAIN_RESOURCE_GROUP}" --query id -o tsv 2>/dev/null || true)"
    if [[ -n "${postgres_id}" ]]; then
      MANAGED_RESOURCE_IDS+=("${postgres_id}")
      log "Knowledge graph: PostgreSQL = ${postgres_id}"
    fi
  fi

  # When no explicit overrides were provided, collect tagged Container Apps and
  # PostgreSQL Flexible Servers in the main RG.
  if [[ ${#MANAGED_RESOURCE_IDS[@]} -eq 0 ]]; then
    local ids
    ids="$(az resource list \
      --resource-group "${MAIN_RESOURCE_GROUP}" \
      --tag "${TAG_FILTER}" \
      --query "[?type=='Microsoft.App/containerApps' || type=='Microsoft.DBforPostgreSQL/flexibleServers'].id" \
      -o tsv 2>/dev/null || true)"
    if [[ -n "${ids}" ]]; then
      while IFS= read -r line; do
        [[ -n "${line}" ]] || continue
        MANAGED_RESOURCE_IDS+=("${line}")
        log "Knowledge graph: ${line}"
      done <<<"${ids}"
    fi
  fi

  if [[ ${#MANAGED_RESOURCE_IDS[@]} -eq 0 ]]; then
    log "Warning: no managed resources resolved for the knowledge graph. SRE Agent will rely on RBAC scope only."
  fi
}

format_managed_resource_ids_json() {
  if [[ ${#MANAGED_RESOURCE_IDS[@]} -eq 0 ]]; then
    echo '[]'
    return
  fi
  local first=1
  local out='['
  local id
  for id in "${MANAGED_RESOURCE_IDS[@]}"; do
    if [[ "${first}" -eq 1 ]]; then
      first=0
    else
      out+=','
    fi
    out+="\"${id}\""
  done
  out+=']'
  echo "${out}"
}

LOCATION="australiaeast"
REGION_CODE=""
DATE_SUFFIX="${NOW_YYYYMMDDHHMM}"
DEPLOYMENT_NAME=""
MAIN_RESOURCE_GROUP=""
TAG_FILTER="GitHub Repository=koudaiii/ai-tour-tokyo-2026"
AGENT_NAME=""
APP_INSIGHTS_NAME=""
CONTAINER_APP_NAME_OVERRIDE=""
POSTGRES_SERVER_OVERRIDE=""
ACCESS_LEVEL="High"
ACTION_MODE="Review"
DRY_RUN=0

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --main-resource-group)
        MAIN_RESOURCE_GROUP="${2:-}"
        shift 2
        ;;
      --tag)
        TAG_FILTER="${2:-}"
        shift 2
        ;;
      --location)
        LOCATION="${2:-}"
        shift 2
        ;;
      --region-code)
        REGION_CODE="${2:-}"
        shift 2
        ;;
      --deployment-name)
        DEPLOYMENT_NAME="${2:-}"
        shift 2
        ;;
      --date-suffix)
        DATE_SUFFIX="${2:-}"
        shift 2
        ;;
      --agent-name)
        AGENT_NAME="${2:-}"
        shift 2
        ;;
      --app-insights-name)
        APP_INSIGHTS_NAME="${2:-}"
        shift 2
        ;;
      --container-app)
        CONTAINER_APP_NAME_OVERRIDE="${2:-}"
        shift 2
        ;;
      --postgres-server)
        POSTGRES_SERVER_OVERRIDE="${2:-}"
        shift 2
        ;;
      --access-level)
        ACCESS_LEVEL="${2:-}"
        shift 2
        ;;
      --action-mode)
        ACTION_MODE="${2:-}"
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Error: unknown option '$1'" >&2
        usage
        exit 1
        ;;
    esac
  done
}

validate_inputs() {
  if [[ ! -f "${TEMPLATE_FILE}" ]]; then
    echo "Error: template file not found: ${TEMPLATE_FILE}" >&2
    exit 1
  fi
  if [[ ! "${DATE_SUFFIX}" =~ ^[0-9]{12}$ ]]; then
    echo "Error: --date-suffix must be 12 digits (YYYYMMDDHHmm)." >&2
    exit 1
  fi
  case "${LOCATION}" in
    eastus2|swedencentral|australiaeast) ;;
    *)
      echo "Error: --location must be one of eastus2, swedencentral, australiaeast (got: ${LOCATION})" >&2
      exit 1
      ;;
  esac
  if [[ -z "${REGION_CODE}" ]]; then
    resolve_region_code_from_location
  fi
  case "${ACCESS_LEVEL}" in
    High|Low) ;;
    *)
      echo "Error: --access-level must be High or Low (got: ${ACCESS_LEVEL})" >&2
      exit 1
      ;;
  esac
  case "${ACTION_MODE}" in
    Review|Automatic) ;;
    *)
      echo "Error: --action-mode must be Review or Automatic (got: ${ACTION_MODE})" >&2
      exit 1
      ;;
  esac
  if [[ -z "${DEPLOYMENT_NAME}" ]]; then
    DEPLOYMENT_NAME="sre-agent-${NOW_YYYYMMDDHHMM}"
  fi
}

print_summary() {
  log "Resolved parameters:"
  log "LOCATION=${LOCATION}"
  log "REGION_CODE=${REGION_CODE}"
  log "DATE_SUFFIX=${DATE_SUFFIX}"
  log "DEPLOYMENT_NAME=${DEPLOYMENT_NAME}"
  log "TAG_FILTER=${TAG_FILTER}"
  log "MAIN_RESOURCE_GROUP=${MAIN_RESOURCE_GROUP}"
  log "AGENT_NAME=${AGENT_NAME:-<auto>}"
  log "APP_INSIGHTS_NAME=${APP_INSIGHTS_NAME}"
  log "ACCESS_LEVEL=${ACCESS_LEVEL}"
  log "ACTION_MODE=${ACTION_MODE}"
  log "MANAGED_RESOURCE_IDS_COUNT=${#MANAGED_RESOURCE_IDS[@]}"
}

print_post_deploy_guide() {
  cat <<EOF

===============================================================
  Azure SRE Agent - Next Steps
===============================================================

Resource Group:  ${SRE_RESOURCE_GROUP_NAME}
SRE Agent:       ${SRE_AGENT_NAME}
Portal URL:      ${SRE_AGENT_PORTAL_URL}

1. Open the SRE Agent portal: https://sre.azure.com/
2. Verify the agent appears in the workspace selector.
3. Try a prompt against the private-isu application:
   - "Why is the Container App responding slowly?"
   - "Check the health of the PostgreSQL Flexible Server."
   - "Summarize recent errors from Application Insights."

Tear down (when finished):
  az group delete --name ${SRE_RESOURCE_GROUP_NAME} --yes --no-wait

===============================================================
EOF
}

main() {
  parse_args "$@"
  require_cmd az
  load_env_file
  ensure_azure_login
  validate_inputs
  ensure_sre_provider_registered

  infer_main_resource_group
  if ! az group show --name "${MAIN_RESOURCE_GROUP}" --output none >/dev/null 2>&1; then
    echo "Error: main resource group '${MAIN_RESOURCE_GROUP}' not found." >&2
    exit 1
  fi

  resolve_app_insights
  resolve_managed_resource_ids
  print_summary

  local managed_resources_json
  managed_resources_json="$(format_managed_resource_ids_json)"

  local -a parameters=(
    "nowYyyymmddHhmm=${DATE_SUFFIX}"
    "workloadCode=${WORKLOAD_CODE}"
    "deploymentEnvironment=${DEPLOYMENT_ENVIRONMENT}"
    "regionCode=${REGION_CODE}"
    "location=${LOCATION}"
    "mainResourceGroupName=${MAIN_RESOURCE_GROUP}"
    "appInsightsAppId=${APP_INSIGHTS_APP_ID}"
    "appInsightsConnectionString=${APP_INSIGHTS_CONNECTION_STRING}"
    "managedResourceIds=${managed_resources_json}"
    "accessLevel=${ACCESS_LEVEL}"
    "actionMode=${ACTION_MODE}"
    "tags=${TAGS_JSON}"
  )
  if [[ -n "${AGENT_NAME}" ]]; then
    parameters+=("sreAgentName=${AGENT_NAME}")
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "Running what-if (no changes applied)"
    run_az deployment sub what-if \
      --name "${DEPLOYMENT_NAME}" \
      --location "${LOCATION}" \
      --template-file "${TEMPLATE_FILE}" \
      --parameters "${parameters[@]}"
    return 0
  fi

  log "Deploying SRE Agent with name=${DEPLOYMENT_NAME}, location=${LOCATION}"
  local deployment_json
  deployment_json="$(az deployment sub create \
    --name "${DEPLOYMENT_NAME}" \
    --location "${LOCATION}" \
    --template-file "${TEMPLATE_FILE}" \
    --parameters "${parameters[@]}" \
    --output json)"

  SRE_RESOURCE_GROUP_NAME="$(echo "${deployment_json}" | jq -r '.properties.outputs.sreResourceGroupName.value')"
  SRE_AGENT_NAME="$(echo "${deployment_json}" | jq -r '.properties.outputs.sreAgentName.value')"
  SRE_AGENT_PORTAL_URL="$(echo "${deployment_json}" | jq -r '.properties.outputs.sreAgentPortalUrl.value')"

  log "Deployment completed"
  print_post_deploy_guide
}

main "$@"
